# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Optional AI tutor provider keys. Keep these ONLY in the backend .env.
# Text tutor: any one of these can be used.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Image / camera question understanding (vision model)
OPENROUTER_VISION_MODEL=google/gemini-2.0-flash-001
